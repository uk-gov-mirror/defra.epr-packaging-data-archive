{
  "DataSource": {
    "Mode": "Stub"
  },
  "CommonDataApi": {
    "Enabled": false,
    "BaseUrl": "https://devrwdwebwa9415.azurewebsites.net",
    "TimeoutSeconds": 120,
    "MaxStreamRows": 10000
  },
  "Mongo": {
    "DatabaseUri": "mongodb://127.0.0.1:27017",
    "DatabaseName": "epr-packaging-data-archive"
  },
  "DetailedErrors": true,
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:o} [{Level:u4}] ({Application}/{MachineName}/{ThreadId}/{SourceContext}.{Method}) {Message}{NewLine}{Exception}"
        }
      }
    ]
  }
}
